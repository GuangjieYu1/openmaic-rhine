# OpenMAIC on Aliyun ECS — copy to /srv/openmaic/.env, chmod 600, never commit.
#
# This file is the runtime env for the compose stack. The image is built WITHOUT
# any of it (the Dockerfile's .dockerignore excludes .env*), so rotating a key here
# needs no rebuild — only a restart.

# ── Required ────────────────────────────────────────────────────────────────
# Image tag produced by: docker build -t openmaic-rhine:<tag> .
OPENMAIC_IMAGE_TAG=openmaic-rhine:v1

# Postgres. Must match DATABASE_URL below.
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>

# The app's server-side persistence. Without DATABASE_URL the course library falls
# back to browser-local storage and /api/reinlab/* answers 404, which would break
# the iPad's native course layer.
DATABASE_URL=postgresql://openmaic:<same password>@postgres:5432/openmaic

# ── Model providers ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=<your key>
DEFAULT_MODEL=deepseek:deepseek-v4-flash
MODEL_ROUTES='{"maic-agent-driver":{"model":"deepseek:deepseek-v4-flash","api":"openai-completions","contextWindow":65536,"thinking":{"enabled":false}}}'
OPENMAIC_AGENT_RUNTIME_ENABLED=true

# ── Xiaomi MiMo TTS ─────────────────────────────────────────────────────────
# MiMo TTS is NOT an OpenAI /audio/speech endpoint; it goes through
# /chat/completions with an assistant-role message (see lib/audio/tts-providers.ts).
MIMO_API_KEY=<your MiMo token-plan key>
MIMO_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# ── REINLAB native course layer ─────────────────────────────────────────────
# The export surface reads these owners' course partitions. Discover the value by
# opening https://<tunnel>/api/reinlab/whoami in the Mac browser that owns the
# courses. Comma-separated: a per-browser owner means one library can span several.
REINLAB_OWNER_ID=<anon:...>
# Optional. Unset = the export surface accepts any caller (fine behind a tunnel
# whose URL only you know; set it if you ever widen access).
# REINLAB_EXPORT_TOKEN=<generate: openssl rand -hex 32>

# ── Behaviour on a plain-HTTP origin ────────────────────────────────────────
# Cloudflare Tunnel terminates TLS, so the browser sees https and the app must
# issue Secure cookies... except the tunnel forwards to http://127.0.0.1:3000, so
# the app's own scheme is http. COOKIE_SECURE=0 is what makes the anonymous owner
# cookie survive that hop; without it every request mints a fresh owner and the
# course list is always empty.
COOKIE_SECURE=0

# ── Do NOT set ──────────────────────────────────────────────────────────────
# PERSISTENCE_SHARED_OWNER_ID requires ACCESS_CODE and would re-partition every
# existing course under a new owner. The REINLAB_OWNER_ID list above is the
# supported way to point the iPad at the existing library.
